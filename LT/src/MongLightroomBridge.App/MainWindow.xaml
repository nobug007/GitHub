<Window x:Class="MongLightroomBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MongLightroomBridge.App.ViewModels"
        xmlns:conv="clr-namespace:MongLightroomBridge.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="MongLightroomBridge" Height="880" Width="1180" MinHeight="700" MinWidth="1000"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="MONGLIGHTROOMBRIDGE" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Lightroom Plugin" Style="{StaticResource LabelText}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="Bold" FontSize="13"
                               Foreground="{Binding IsLightroomConnected, Converter={x:Static conv:BoolToStatusBrushConverter.Instance}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: job form -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="입력 폴더" Style="{StaticResource LabelText}" />
                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding InputFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="찾아보기" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                    Command="{Binding BrowseInputFolderCommand}" />
                        </Grid>

                        <TextBlock Text="출력 폴더" Style="{StaticResource LabelText}" />
                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="찾아보기" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                    Command="{Binding BrowseOutputFolderCommand}" />
                        </Grid>

                        <TextBlock Text="자동 보정 프로필" Style="{StaticResource LabelText}" />
                        <ComboBox Margin="0,2,0,10" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="포맷" Style="{StaticResource LabelText}" />
                                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="품질 (JPEG)" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding Quality, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="크롭/종횡비" Style="{StaticResource LabelText}" />
                        <ComboBox Margin="0,2,0,14" ItemsSource="{Binding CropAspectOptions}" SelectedItem="{Binding SelectedCropAspect}" />

                        <!-- Sliders -->
                        <Grid Style="{StaticResource SliderLabelRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Exposure" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Exposure, StringFormat={}{0:0.00}}" Style="{StaticResource ValueText}" FontSize="12" />
                        </Grid>
                        <Slider Minimum="-5" Maximum="5" Value="{Binding Exposure}" TickFrequency="0.05" IsSnapToTickEnabled="True" />

                        <Grid Style="{StaticResource SliderLabelRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Contrast" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Contrast, StringFormat={}{0:0}}" Style="{StaticResource ValueText}" FontSize="12" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" TickFrequency="1" IsSnapToTickEnabled="True" />

                        <Grid Style="{StaticResource SliderLabelRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Highlights" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Highlights, StringFormat={}{0:0}}" Style="{StaticResource ValueText}" FontSize="12" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Highlights}" TickFrequency="1" IsSnapToTickEnabled="True" />

                        <Grid Style="{StaticResource SliderLabelRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Shadows" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Shadows, StringFormat={}{0:0}}" Style="{StaticResource ValueText}" FontSize="12" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Shadows}" TickFrequency="1" IsSnapToTickEnabled="True" />

                        <Grid Style="{StaticResource SliderLabelRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Whites" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Whites, StringFormat={}{0:0}}" Style="{StaticResource ValueText}" FontSize="12" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Whites}" TickFrequency="1" IsSnapToTickEnabled="True" />

                        <Grid Style="{StaticResource SliderLabelRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Blacks" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Blacks, StringFormat={}{0:0}}" Style="{StaticResource ValueText}" FontSize="12" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Blacks}" TickFrequency="1" IsSnapToTickEnabled="True" />

                        <Grid Style="{StaticResource SliderLabelRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Temperature (delta K)" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Temperature, StringFormat={}{0:0}}" Style="{StaticResource ValueText}" FontSize="12" />
                        </Grid>
                        <Slider Minimum="-2000" Maximum="2000" Value="{Binding Temperature}" TickFrequency="10" IsSnapToTickEnabled="True" />

                        <Grid Style="{StaticResource SliderLabelRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Tint (delta)" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Tint, StringFormat={}{0:0}}" Style="{StaticResource ValueText}" FontSize="12" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Tint}" TickFrequency="1" IsSnapToTickEnabled="True" />

                        <Grid Style="{StaticResource SliderLabelRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Vibrance" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Vibrance, StringFormat={}{0:0}}" Style="{StaticResource ValueText}" FontSize="12" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Vibrance}" TickFrequency="1" IsSnapToTickEnabled="True" />

                        <Grid Style="{StaticResource SliderLabelRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Saturation" Style="{StaticResource LabelText}" />
                            <TextBlock Grid.Column="1" Text="{Binding Saturation, StringFormat={}{0:0}}" Style="{StaticResource ValueText}" FontSize="12" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding Saturation}" TickFrequency="1" IsSnapToTickEnabled="True" />

                        <CheckBox Content="드라이런 (Lightroom 없이 로컬로만 시뮬레이션)" Foreground="{StaticResource TextBrush}"
                                  Margin="0,16,0,0" IsChecked="{Binding IsDryRun}" />

                        <CheckBox Content="초점이 안 맞는(흐린) 사진 제외" Foreground="{StaticResource TextBrush}"
                                  Margin="0,10,0,0" IsChecked="{Binding ExcludeBlurryPhotos}"
                                  ToolTip="선명도가 낮은 사진을 자동 보정에서 제외합니다." />
                        <CheckBox Content="눈이 열린 것을 확인할 수 없는 사진 제외" Foreground="{StaticResource TextBrush}"
                                  Margin="0,6,0,0" IsChecked="{Binding ExcludeUncertainEyePhotos}"
                                  ToolTip="얼굴/눈을 인식하지 못한 사진을 제외합니다. 안경 반사광 등으로 실제로는 눈을 뜬 사진도 제외될 수 있습니다 (눈을 감았다는 뜻은 아닙니다)." />

                        <Button Content="자동 보정 실행" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                Command="{Binding RunCommand}" />
                        <Button Content="작업 폴더 열기" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                Command="{Binding OpenJobsFolderCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: progress / log / results -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextBrush}" FontSize="14" />
                        <ProgressBar Height="8" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="로그" Style="{StaticResource LabelText}" Margin="4,0,0,6" />
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="12" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="처리 결과" Style="{StaticResource LabelText}" Margin="4,0,0,6" />
                        <ListBox ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                 Fill="{Binding Converter={x:Static conv:JobResultStatusBrushConverter.Instance}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="{StaticResource TextBrush}" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding Error}"
                                                   Foreground="{Binding Skipped, Converter={x:Static conv:SkippedToWarnOrBadBrushConverter.Instance}}"
                                                   FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
